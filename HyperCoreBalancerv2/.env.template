# =============================================================================
# HyperCore Cluster Balancer - Environment Template
# =============================================================================
# Copy this file to .env and update all CHANGE_ME values.
#
# IMPORTANT:
# - Keep SC_DRY_RUN=true until you have validated behavior in logs.
# - If a value contains $, wrap it in single quotes to avoid Docker Compose
#   interpreting part of it as an environment variable.
#
# Example:
#   SC_PASSWORD='password$abc123'
# =============================================================================


# =============================================================================
# Scale Computing HyperCore API
# =============================================================================

# HyperCore cluster endpoint.
# Recommended format:
#   https://scalehcx.example.org
#
# The app normalizes this internally to /rest/v1 where needed.
SC_HOST=https://CHANGE_ME

# HyperCore API account.
# Needs read access for collector/dashboard metrics.
# Needs write/migration permissions if SC_DRY_RUN=false.
SC_USERNAME=CHANGE_ME
SC_PASSWORD=CHANGE_ME

# Usually false for internal/self-signed HyperCore certificates.
SC_VERIFY_SSL=false


# =============================================================================
# Cached HyperCore Session Authentication
# =============================================================================
# The collector and balancer use session-based login and cache session cookies.
# Each container should use its own SC_SESSION_FILE in docker-compose.yaml.
#
# Recommended docker-compose values:
#   collector:
#     SC_SESSION_FILE=/config/session/collector_scale_session.p
#   balancer:
#     SC_SESSION_FILE=/config/session/balancer_scale_session.p

# 43200 seconds = 12 hours
SC_SESSION_MAX_AGE_SECONDS=43200


# =============================================================================
# External InfluxDB v2
# =============================================================================
# Existing externally hosted InfluxDB instance.
# The bundled InfluxDB container is not used.

INFLUX_URL=https://CHANGE_ME
INFLUX_TOKEN=CHANGE_ME
INFLUX_ORG=CHANGE_ME
INFLUX_BUCKET=metrics

# Retention period, in days, for the primary bucket.
# If your external InfluxDB token does not have bucket-management permissions,
# the collector may warn that it cannot update retention. That is usually okay.
INFLUX_PRIMARY_RETENTION=365

# Optional long-term bucket name, if you manually create downsampling tasks.
# The external deployment does not automatically create this.
INFLUX_LONGTERM_BUCKET=metrics_longterm
INFLUX_LONGTERM_RETENTION=1825

# Influx write retry behavior
INFLUX_WRITE_RETRIES=3
INFLUX_RETRY_DELAY=5


# =============================================================================
# External Grafana
# =============================================================================
# Existing Grafana URL used by the dashboard Tools tab.
# This is only for opening Grafana from the UI.
# Grafana auth/SSO remains handled by Grafana itself.

GRAFANA_URL=https://CHANGE_ME


# =============================================================================
# Built-in Dashboard
# =============================================================================

# Dashboard listens on port 5000 from docker-compose.
SC_DASHBOARD_USER=admin
SC_DASHBOARD_PASSWORD=CHANGE_ME

# Data older than this many seconds may be shown as stale in the dashboard.
SC_DASHBOARD_STALE_SECONDS=120


# =============================================================================
# Collector
# =============================================================================

# Fast metrics polling interval, in seconds.
SC_POLL_INTERVAL=30

# Slow inventory/health polling interval, in seconds.
SC_SLOW_POLL_INTERVAL=300


# =============================================================================
# Balancer - Master Controls
# =============================================================================

# Start in dry-run mode.
# true  = log decisions only, do not live migrate
# false = execute live migrations
SC_DRY_RUN=true

# Log verbosity:
# 0 = important only
# 1 = normal
# 2 = detailed
# 3 = very detailed
SC_VERBOSITY=2


# =============================================================================
# Balancer - Reactive Engine
# =============================================================================

# Sliding average window used for CPU/RAM decisions.
SC_AVG_WINDOW_MINUTES=5

# Sampling interval used by the balancer.
SC_SAMPLE_INTERVAL_SECONDS=30

# Node CPU percentage that triggers CPU-focused reactive balancing.
SC_CPU_UPPER_THRESHOLD_PERCENT=50.0

# Node RAM percentage that triggers RAM-focused reactive balancing.
SC_RAM_UPPER_THRESHOLD_PERCENT=65.0

# Hard target RAM ceiling. The balancer will not intentionally place VMs
# onto a node if projected RAM usage exceeds this percentage.
SC_RAM_LIMIT_PERCENT=85.0

# Maximum vCPU-to-thread overcommit ratio allowed on a target node.
SC_MAX_VCPU_RATIO=2.0

# Cooldown before the same VM can be moved again.
SC_VM_MOVE_COOLDOWN_MINUTES=30

# Cluster-wide cooldown between migrations.
SC_MIGRATION_COOLDOWN_MINUTES=5

# Comma-separated node LAN IPs to exclude from balancing.
# Example:
#   SC_EXCLUDE_NODE_IPS=10.0.0.241,10.0.0.242
SC_EXCLUDE_NODE_IPS=


# =============================================================================
# Balancer - Predictive Engine / Oracle
# =============================================================================

# Enable predictive balancing.
SC_PREDICTIVE_BALANCING_ENABLED=true

# How often the Oracle runs.
# 43200 seconds = 12 hours.
SC_PREDICTIVE_INTERVAL_SECONDS=43200

# Predicted future CPU threshold that triggers recommendations.
SC_PREDICTIVE_THRESHOLD=80.0

# Minimum required history before forecasting a VM.
# 336 hours = 14 days.
SC_PREDICTIVE_MIN_HISTORY_HOURS=336

# Historical lookback window queried from InfluxDB.
SC_PREDICTIVE_LOOKBACK_DAYS=90

# Number of parallel forecast workers.
# Keep this at or below available CPU cores for the balancer container.
SC_PREDICTIVE_MAX_WORKERS=4

# Execute predictive migration this many hours before predicted peak.
SC_PREDICTIVE_LEAD_TIME_HOURS=1

# Reserve the source node this many minutes after predicted peak.
SC_PREDICTIVE_RESERVATION_MINUTES=5

# Optional jitter applied to predictive interval.
# 0.1 = up to 10 percent random delay.
# 0 = exact interval.
SC_PREDICTIVE_JITTER_PERCENT=0.1


# =============================================================================
# Balancer - Predictive Model Tuning
# =============================================================================
# These are optional enhancements if you added the configurable Prophet tuning.

SC_PREDICTIVE_DAILY_SEASONALITY=15
SC_PREDICTIVE_WEEKLY_SEASONALITY=20
SC_PREDICTIVE_SEASONALITY_PRIOR_SCALE=15.0
SC_PREDICTIVE_CHANGEPOINT_PRIOR_SCALE=0.05

# upper = conservative/worst-case planning
# mean  = less aggressive
# lower = probably too relaxed for production balancing
SC_PREDICTIVE_CONFIDENCE_MODE=upper

# Ignore VM forecasts whose predicted peak CPU is below this value.
SC_PREDICTIVE_MIN_VM_PEAK_CPU=5.0


# =============================================================================
# Predictive Forecast Export / Debug
# =============================================================================
# Forecast CSVs are saved inside the balancer container.
# docker-compose should mount:
#   sc-model-cache:/models

SC_PREDICTIVE_MODEL_CACHE_DIR=/models
SC_PREDICTIVE_SAVE_FORECASTS=true

# Optional: forecast only one VM by exact VM name.
# Leave blank for all VMs.
SC_PREDICTIVE_DEBUG_VM_NAME=


# =============================================================================
# Optional Docker / Local Tooling
# =============================================================================
# These are not needed when using external Grafana.
# Left here only for reference if someone restores the bundled Grafana profile.
#
# GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME
